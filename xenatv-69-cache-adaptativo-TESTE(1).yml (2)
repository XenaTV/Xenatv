name: XenaTV 6.9 - Cache de Capas Adaptativo (TESTE)

# Compilacao de teste isolada. Nao altera o workflow ou o APK atual.
on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 65
    steps:
      - name: Baixar arquivos do repositorio
        uses: actions/checkout@v4

      - name: Validar arquivos necessarios
        shell: bash
        run: |
          set -euo pipefail
          test -f XenaTV_69_PLAYER_CONTROLES_CODIGO_TESTE.zip
          test -f XenaTV_Android_LibVLC_Teste1.zip
          test -f patch_filmes_69.py
          test -f .github/workflows/xenatv-premium-6-9-revisao-cosmica-pipoou-compacta.yml
          python3 - <<'PY'
          from pathlib import Path
          import zipfile
          compact=Path('.github/workflows/xenatv-premium-6-9-revisao-cosmica-pipoou-compacta.yml')
          assert compact.stat().st_size <= 500_000, 'Base compacta excedeu 500 KB'
          z=zipfile.ZipFile('XenaTV_69_PLAYER_CONTROLES_CODIGO_TESTE.zip')
          required=['patch_xenatv_69_integrada.py','patch_player_69.py','1000510040.jpg']
          for item in required:
              assert z.namelist().count(item)==1, 'Arquivo ausente/duplicado: '+item
              Path(item).write_bytes(z.read(item))
          PY
          python3 -m py_compile patch_xenatv_69_integrada.py patch_player_69.py patch_filmes_69.py

      - name: Instalar Java e Android SDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v4
      - name: Instalar plataforma Android
        run: sdkmanager 'platforms;android-36' 'build-tools;35.0.0'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Restaurar base 6.9 e preservar correcao dos filmes
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import base64,lzma,pathlib,re
          p=pathlib.Path('.github/workflows/xenatv-premium-6-9-revisao-cosmica-pipoou-compacta.yml')
          s=p.read_text(encoding='utf-8')
          m=re.search(r'payload = """\s*(.*?)\s*"""',s,re.S)
          if not m: raise RuntimeError('Base compacta sem payload')
          pathlib.Path('xena-build-step.sh').write_bytes(lzma.decompress(base64.b85decode(''.join(m.group(1).split()))))
          PY
          python3 patch_filmes_69.py
          bash xena-build-step.sh

      - name: Integrar icones, tela dupla e controles de video
        shell: bash
        run: |
          set -euo pipefail
          python3 -m pip install --quiet Pillow
          python3 patch_xenatv_69_integrada.py
          python3 patch_player_69.py
          python3 - <<'PY'
          from pathlib import Path
          base=Path('xena-premium/XenaTV_Android/app/src/main')
          player=(base/'java/br/com/xenatv/app/FullScreenPlayerActivity.java').read_text()
          main=(base/'java/br/com/xenatv/app/MainActivity.java').read_text()
          for key in ('buildPlayerBar()', 'skipSeconds(-10)', 'skipSeconds(10)', 'playSecond(', 'setAudible('):
              assert key in player, 'Funcao ausente: '+key
          assert 'xenaNavImage(' in main, 'Icones nao aplicados'
          assert len(list((base/'res/drawable-nodpi').glob('xena_nav_*.png'))) == 9
          print('Integracao base validada.')
          PY

      - name: Ajustar cache de imagens conforme heap Android
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import re
          f=Path('xena-premium/XenaTV_Android/app/src/main/java/br/com/xenatv/app/ChannelArtwork.java')
          original=f.read_text(encoding='utf-8')
          marker='XENA_CACHE_ADAPTATIVO_69'
          if marker in original:
              print('Cache adaptativo ja presente; nenhuma duplicacao.')
          else:
              regex=r'new\s+LruCache\s*<\s*String\s*,\s*Bitmap\s*>\s*\(\s*24\s*\*\s*1024\s*\)'
              replacement=('new LruCache<String,Bitmap>('
                  'Math.max(4096,Math.min(24576,(int)(Runtime.getRuntime().maxMemory()/12288L))))'
                  ' /* XENA_CACHE_ADAPTATIVO_69 */')
              updated,count=re.subn(regex,replacement,original)
              if count!=1:
                  raise RuntimeError('Esperado um cache de 24 MiB; achei '+str(count)+'. Nao alterei o codigo.')
              assert updated.count(marker)==1
              f.write_text(updated,encoding='utf-8')
              print('Cache adaptativo aplicado: 4 a 24 MiB, conforme heap. Capas e player preservados.')
          PY

      - name: Compilar APK otimizado (teste)
        working-directory: xena-premium/XenaTV_Android
        run: gradle --no-daemon --stacktrace assembleDebug

      - name: Publicar APK de teste
        uses: actions/upload-artifact@v4
        with:
          name: XenaTV-6-9-CACHE-ADAPTATIVO-TESTE-APK
          path: xena-premium/XenaTV_Android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
